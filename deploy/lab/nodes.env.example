# Lab node addresses — FORMAT EXAMPLE (this file is tracked; the real one is not).
#
# Copy to `nodes.env` in this directory and fill in your own addresses:
#
#   cp deploy/lab/nodes.env.example deploy/lab/nodes.env
#
# `deploy/lab-test.sh`, `deploy/lab-validate.sh` and `tests/lab_replication_mesh.sh`
# source it. Every one of them used to carry our own addresses inline, which meant the
# repository named our infrastructure in five places with nothing keeping them in
# agreement — and one of them, `lab-validate.sh`, had the registry address written twice
# in the same file. A reader outside our network could not use any of it, and a second
# lab would have been a grep-and-replace.
#
# Each variable can also be overridden from the environment, so a one-off run against a
# different node needs no file edit:
#
#   LAB_DC1_MGMT=10.0.0.9 bash deploy/lab-validate.sh
#
# ⚠️ Without this file and without those variables, the lab scripts do NOT fall back to a
# default — they say so and stop, and `lab_replication_mesh.sh` SKIPs with a message that
# names this file. A guessed address would reach *something*, and a suite that quietly
# tests the wrong host is worse than one that does not run.

# How WE reach each DC — management addresses, used for SSH and for the console.
LAB_DC1_MGMT=10.0.0.1
LAB_DC2_MGMT=10.0.0.2
LAB_DC3_MGMT=10.0.0.3

# The replication interconnect — deliberately a SEPARATE network from the management
# one, so `lab_replication_mesh.sh` can cut it to simulate a partition without dropping
# its own SSH session. These must match the `host=` values in `topology`.
LAB_DC1_LINK=10.10.10.21
LAB_DC2_LINK=10.10.10.22
LAB_DC3_LINK=10.10.10.23

# The Docker registry the build node pushes to and every DC pulls from.
LAB_REGISTRY=10.0.0.1:5000
