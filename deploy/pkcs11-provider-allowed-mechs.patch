 #include "obj/internal.h"
 
+/* Fetch CKA_ALLOWED_MECHANISMS from the token when it is not already cached
+ * on the object, and cache the result.  Returns a pointer to the cached
+ * attribute on success, NULL if the attribute is absent or unsupported. */
+static CK_ATTRIBUTE *get_or_fetch_allowed_mechs(P11PROV_OBJ *obj)
+{
+    CK_ATTRIBUTE *am;
+
+    am = p11prov_obj_get_attr(obj, CKA_ALLOWED_MECHANISMS);
+        #ifndef NDEBUG
+        fprintf(stderr, "P11P-DEBUG get_or_fetch: obj=%p class=%lu\n", (void*)obj, (unsigned long)obj->class);
+        #endif
+    if (am && am->ulValueLen > 0) return am;
+        #ifndef NDEBUG
+        fprintf(stderr, "P11P-DEBUG cached am=%p len=%lu\n", (void*)am, am ? (unsigned long)am->ulValueLen : 0);
+        #endif
+
+    /* The RSA-PSS keygen sets CKA_ALLOWED_MECHANISMS on the private key but
+     * SoftHSM does not mirror it to the public key.  So the attribute lives
+     * only on the private object.  When obj itself is a private key, read
+     * from it directly; only cross to its private-key pair when obj is a
+     * public key that needs its companion. */
+    P11PROV_OBJ *pub = obj;
+    P11PROV_OBJ *free_me = NULL;
+    if (obj->class == CKO_PUBLIC_KEY) {
+        pub = p11prov_obj_find_associated(obj, CKO_PRIVATE_KEY);
+        if (!pub) return NULL;
+        free_me = pub;
+    }
+    if (pub->class != CKO_PUBLIC_KEY && pub->class != CKO_PRIVATE_KEY) {
+        if (free_me) p11prov_obj_free(free_me);
+        return NULL;
+    }
+
+    CK_OBJECT_HANDLE h = p11prov_obj_get_handle(pub);
+    if (h == CK_INVALID_HANDLE) {
+        if (free_me) p11prov_obj_free(free_me);
+        return NULL;
+    }
+
+    P11PROV_SESSION *session = NULL;
+    CK_RV ret = p11prov_try_session_ref(pub, 0,
+        pub->class == CKO_PRIVATE_KEY ? true : false, false, &session);
+    if (ret != CKR_OK) {
+        if (free_me) p11prov_obj_free(free_me);
+        return NULL;
+    }
+
+    CK_SESSION_HANDLE sh = p11prov_session_handle(session);
+    CK_ATTRIBUTE attr = { CKA_ALLOWED_MECHANISMS, NULL, 0 };
+    p11prov_set_error_mark(pub->ctx);
+    ret = p11prov_GetAttributeValue(pub->ctx, sh, h, &attr, 1);
+    #ifndef NDEBUG
+    fprintf(stderr, "P11P-DEBUG GetAttr ret=%lu len=%lu\n", (unsigned long)ret, (unsigned long)attr.ulValueLen, (unsigned long)pub->class);
+    #endif
+    if ((ret == CKR_OK || ret == CKR_ATTRIBUTE_TYPE_INVALID)
+        && attr.ulValueLen > 0
+        && attr.ulValueLen != CK_UNAVAILABLE_INFORMATION) {
+        attr.pValue = OPENSSL_malloc(attr.ulValueLen);
+        if (attr.pValue) {
+            ret = p11prov_GetAttributeValue(pub->ctx, sh, h, &attr, 1);
+    #ifndef NDEBUG
+    fprintf(stderr, "P11P-DEBUG GetAttr ret=%lu len=%lu\n", (unsigned long)ret, (unsigned long)attr.ulValueLen, (unsigned long)pub->class);
+    #endif
+            if (ret == CKR_OK) {
+                p11prov_obj_add_attr(obj, &attr);
+                attr.pValue = NULL;
+                p11prov_pop_error_to_mark(pub->ctx);
+                p11prov_return_session(session);
+                if (free_me) p11prov_obj_free(free_me);
+                am = p11prov_obj_get_attr(obj, CKA_ALLOWED_MECHANISMS);
+        #ifndef NDEBUG
+        fprintf(stderr, "P11P-DEBUG get_or_fetch: obj=%p class=%lu\n", (void*)obj, (unsigned long)obj->class);
+        #endif
+                return (am && am->ulValueLen > 0) ? am : NULL;
+            }
+            OPENSSL_free(attr.pValue);
+        }
+    }
+    p11prov_clear_last_error_mark(pub->ctx);
+    p11prov_return_session(session);
+    if (free_me) p11prov_obj_free(free_me);
+    return NULL;
+}
